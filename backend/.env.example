# ---------------------------------------------------------------------------
# Streixpei API configuration. Copy to `.env` and fill in the blanks.
# Never commit the real `.env`.
# ---------------------------------------------------------------------------

# development | production | test
ENVIRONMENT=development
APP_NAME=Streixpei
COMPANY_NAME=Streixcorp
SUPPORT_EMAIL=support@streixpei.com
TIMEZONE=Africa/Lagos
LOG_LEVEL=INFO

# Public URLs (no trailing slash). FRONTEND_URL is used in emails, QR codes
# and Paystack callbacks; API_URL is where this server is reachable.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------- database
# Any postgres:// URL works; it is converted to the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/streixpei
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------ redis
# Sessions, rate limits, locks and caches.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# The refresh cookie is httpOnly. If the web app and the API are on different
# sites (e.g. app.vercel.app and api.onrender.com) set COOKIE_SAMESITE=none
# (requires HTTPS). If they share a parent domain, keep "lax" and optionally
# set COOKIE_DOMAIN=.yourdomain.com.
COOKIE_SAMESITE=lax
# COOKIE_SECURE defaults to true in production.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# ------------------------------------------------------------------ email
# Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as MAIL_PASSWORD.
# Gmail allows about 500 messages a day; use a transactional provider
# (Brevo, Postmark, SES, Mailgun) with the same settings as you grow.
MAIL_ENABLED=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Streixpei

# --------------------------------------------------------------- payments
# "fake" simulates Paystack for local development (refused in production):
# account numbers ending in 13 fail transfers, ones starting with 000 can't
# be resolved, and checkout opens a local test page.
PAYMENTS_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# In the Paystack dashboard:
#   1. Settings > API Keys & Webhooks > Webhook URL:
#        https://<your-api-domain>/api/v1/webhooks/paystack
#   2. Settings > Preferences > Transfers: turn OFF "Confirm transfers
#      before sending" (OTP), or payroll can't be sent automatically.
#   3. Settlements: settle collections to your Paystack balance (not your
#      bank) so the balance can fund payroll transfers.
#   4. Dedicated virtual accounts (a permanent account number per workgroup)
#      must be requested from Paystack support. Set to true once enabled.
PAYSTACK_DVA_ENABLED=false
PAYSTACK_DVA_PREFERRED_BANK=wema-bank

# --------------------------------------------------------------------- AI
# SPI, the in-app assistant. Without a key it runs in basic mode (direct
# commands only). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1200

# ------------------------------------------------------------------ admin
# The platform admin account is created on first start-up if it doesn't exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# -------------------------------------------------------------- scheduler
# Background jobs (emails, paydays, reconciliation, renewals). Safe to run on
# several instances: every job takes a Redis lock.
SCHEDULER_ENABLED=true
